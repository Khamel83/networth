# ===========================================
# NET WORTH Tennis - Environment Variables
# Set these in Vercel > Project > Settings > Environment Variables.
# Never commit real values: this repository is public.
# ===========================================

# Supabase (database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-side key the API uses (RLS denies the anon key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
SITE_URL=https://www.networthtennis.com

# Email (Resend, verified domain networthtennis.com)
RESEND_API_KEY=re_your_key
# disabled (safe default) | dry_run (count targets, send nothing) | live
EMAIL_DELIVERY_MODE=disabled
# Second opt-in for welcome + password-reset mail to the person signing up
PUBLIC_TRANSACTIONAL_EMAILS=
# Sysadmin address for technical alerts (not Natalie/Ashley)
ADMIN_EMAIL=admin@example.com

# Shared secret for GitHub Actions -> API calls (must match the GitHub secret)
CRON_SECRET=random-secret-string

# Optional error tracking
SENTRY_DSN=

# GitHub Actions secrets needed: CRON_SECRET, SITE_URL, SUPABASE_URL, SUPABASE_ANON_KEY
