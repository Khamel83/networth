# ===========================================
# NET WORTH Tennis - Environment Variables
# ===========================================

# ===========================================
# Supabase (Free tier)
# ===========================================
# Auth handled by Supabase (magic links)
# Email templates configured in Supabase Dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ===========================================
# Site Configuration
# ===========================================
SITE_URL=https://networthtennis.com

# ===========================================
# Admin
# ===========================================
ADMIN_EMAIL=admin@example.com

# ===========================================
# Cron - Using GitHub Actions (FREE)
# No Vercel Pro needed
# ===========================================
CRON_SECRET=random-secret-string
