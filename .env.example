# ===========================================
# NET WORTH Tennis - Environment Variables
# ===========================================

# ===========================================
# Supabase (Free tier)
# ===========================================
# Auth handled by Supabase (magic links)
# Email templates configured in Supabase Dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ===========================================
# Site Configuration
# ===========================================
SITE_URL=https://networthtennis.com

# ===========================================
# Email (Gmail SMTP)
# ===========================================
# Get app password: Google Account > Security > 2FA > App passwords
# Format: 16 characters, no spaces (e.g., abcd efgh ijkl mnop -> abcdefghijklmnop)
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SENDER_NAME=Your Tennis League

# ===========================================
# Admin
# ===========================================
ADMIN_EMAIL=admin@example.com

# ===========================================
# Admin Flex (for odd-player pairing logic)
# ===========================================
# These admins sit out when there's an odd number of players
# Primary sits out odd months (Jan, Mar, May...), Secondary sits out even months
ADMIN_FLEX_EMAILS=admin1@example.com,admin2@example.com
ADMIN_FLEX_PRIMARY=admin1@example.com
ADMIN_FLEX_SECONDARY=admin2@example.com

# ===========================================
# Cron - Using GitHub Actions (FREE)
# No Vercel Pro needed
# ===========================================
CRON_SECRET=random-secret-string
